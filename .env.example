NEXON_API_KEY=
# AI 상담·화면 분석 (선택): OPENAI_API_KEY·ADMIN_PASSWORD_HASH·SESSION_SECRET 셋 다 있어야 켜진다(지금은 셋이 묶여 있다)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
AGENT_DAILY_TOKEN_BUDGET=200000
# 일반 사용자 하루 한도(IP당): AI 상담 질문 수, AI 화면 판독 수, 분당 화면 수
AGENT_PUBLIC_DAILY=5
VISION_PUBLIC_DAILY=20
VISION_FRAMES_PER_MIN=240
# 경매장 관측 기록 영구 저장(Neon 등 Postgres). 비우면 SQLite
DATABASE_URL=
# AI 상담 추적(Langfuse, 선택). 비우면 추적 안 함. 지역: EU https://cloud.langfuse.com · US https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# 웹 경매장 시세 검색 (선택, 로컬 PC 전용): maple-auction-mcp + 크롬 확장 + 웹 경매장 로그인 필요.
# 공식 API가 아니라 로그인한 브라우저로 경매장 검색을 대신 한다 — 계정 위험을 알고 켤 것. 일일 검색 100회 한도.
AUCTION_MCP_CMD=
# 예(Windows): AUCTION_MCP_CMD=npx.cmd -y maple-auction-mcp
# 화면 분석 학습 데이터 (선택, 로컬 전용): 프레임·AI 판독·내가 고친 값을 이 폴더에만 저장한다. 업로드하지 않는다.
VISION_DATASET_DIR=
# 예: VISION_DATASET_DIR=.data/vision
